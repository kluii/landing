# Host-specific headers (Netlify-style). hosting/Caddyfile carries the same set for Caddy.
# Inline script hashes are appended by scripts/write-headers.mjs after the build.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*.png
  Cache-Control: public, max-age=3600

/docs/*.md
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  Content-Type: text/markdown; charset=utf-8
