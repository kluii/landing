# Build-time environment for klui-site. Copy to .env for local builds.
# PUBLIC_* values are inlined into the HTML at build time — never put a secret here.

# Canonical origin of the site (canonicals, OG URLs, sitemap, llms.txt)
PUBLIC_SITE_URL=https://klui.wyliam.dev

# Live demo board. Unset (or unreachable at build time) omits the demo link.
# PUBLIC_DEMO_URL=https://demo.klui.wyliam.dev/w/demo-team/klui-demo-a4f2

# Cookieless analytics endpoint. Unset means zero script tags and zero requests.
# PUBLIC_ANALYTICS_URL=

# Application repository (install snippet, social links)
PUBLIC_GITHUB_URL=https://github.com/kluii/app

# Docs version the switcher opens on
PUBLIC_DOCS_VERSION=v2

# Legal placeholders. A production build fails while any of these is unset.
# LEGAL_OPERATOR=
# LEGAL_CONTACT=
# LEGAL_REGION=

# Reproducible builds (lastmod, OG timestamps)
# SOURCE_DATE_EPOCH=
