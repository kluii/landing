---
// SPDX-License-Identifier: AGPL-3.0-only
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/fonts.css';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { LINKS } from '../data/links.ts';
import { siteJsonLd } from '../data/structured.ts';
import { ogNameFor, routeToRel } from '../data/og.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: 'en' | 'fr';
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  frPath?: string | undefined;
  enPath?: string | undefined;
}

const {
  title,
  description,
  path,
  lang = 'en',
  ogType = 'website',
  ogImage,
  noindex = false,
  frPath,
  enPath,
} = Astro.props;

const canonical = `${LINKS.site}${path}`;
const ogImg = ogImage ?? `${LINKS.site}/og/${ogNameFor(routeToRel(path))}`;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {lang === 'en' ? (
      <link rel="alternate" hreflang="en" href={canonical} />
    ) : (
      enPath && <link rel="alternate" hreflang="en" href={`${LINKS.site}${enPath}`} />
    )}
    {lang === 'fr' && <link rel="alternate" hreflang="fr" href={canonical} />}
    {frPath && <link rel="alternate" hreflang="fr" href={`${LINKS.site}${frPath}`} />}
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : enPath ? `${LINKS.site}${enPath}` : canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd())} />
    <link
      rel="preload"
      href="/fonts/newsreader-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/fonts/inter-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/fonts/inter-500-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <Footer path={path} lang={lang} />
    <Analytics />
  </body>
</html>
