---
// SPDX-License-Identifier: AGPL-3.0-only
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import GlyphGrid from '../components/GlyphGrid.astro';
import Plate from '../components/Plate.astro';
import BoardMock from '../components/BoardMock.astro';
import Section from '../components/Section.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ArrowLink from '../components/ArrowLink.astro';
import CopyButton from '../components/CopyButton.astro';
import { CLAIMS } from '../data/claims.ts';
import { INSTALL_COMMANDS, MCP_CONFIG } from '../data/snippets.ts';
import { PLATE_CAPTION, CLOSE_OUT } from '../data/mock.ts';
---

<Base
  title="Klui — a kanban for projects that end"
  description="Klui is a fast, self-hosted board where a link is the invite, agents read and write through MCP, and every project closes with a summary you can hand over."
  path="/"
  lang="en"
>
  <Nav lang="en" />
  <main id="main">
    <div class="hero-zone">
      <GlyphGrid />
      <Hero />
    </div>

    <Plate caption={PLATE_CAPTION}>
      <BoardMock />
    </Plate>

    <Section>
      <h2 class="sr-only">Why Klui</h2>
      <div class="three-lines">
        <div class="line-row">
          <div>
            <h3 class="line-claim">No account to join.</h3>
            <p class="line-body">
              A teammate, a client, a stranger: send the link, they pick a display name, they
              work. Nothing to install, nothing to verify.
            </p>
          </div>
          <ArrowLink href="/docs/v2/permissions">Read the permissions model</ArrowLink>
        </div>
        <div class="line-row">
          <div>
            <h3 class="line-claim">Agents are participants, not integrations.</h3>
            <p class="line-body">
              Per-board keys, {CLAIMS.tools.value} MCP tools, and the same permissions a human
              has. The setup block is on the page.
            </p>
          </div>
          <ArrowLink href="/docs/v2/mcp">Read the MCP reference</ArrowLink>
        </div>
        <div class="line-row">
          <div>
            <h3 class="line-claim">The project has an end.</h3>
            <p class="line-body">
              Closing a board freezes it and writes a summary from the event log: what got
              done, by whom, and what is left.
            </p>
          </div>
          <ArrowLink href="/docs/v2/features/close-out">See a close-out summary</ArrowLink>
        </div>
      </div>
    </Section>

    <Section title="Three commands, one container.">
      <div class="install-grid">
        <CodeBlock code={INSTALL_COMMANDS} lang="bash" copyLabel="Copy the install command" />
        <div class="install-steps">
          <p>
            Clone the repository, copy the example environment file, start the stack. The
            compose file brings Postgres 16 with it; the first account created becomes the
            instance admin.
          </p>
          <p>
            Set <code>KLUI_PUBLIC_URL</code> in <code>.env</code> to the absolute URL the
            instance is reachable at — it is required in production.
          </p>
          <p>
            <code>docker compose down</code> keeps the data volume; <code>down -v</code>{' '}
            deletes it.
          </p>
          <p class="install-caption mono">
            Tested on a {CLAIMS.installInstance.value} instance. Postgres 16 is included.
          </p>
          <ArrowLink href="/docs/v2/quickstart">Full quickstart</ArrowLink>
        </div>
      </div>
    </Section>

    <Section title="The project ends, and the summary writes itself.">
      <div class="end-grid">
        <p class="end-copy">
          Closing a board freezes it and generates the summary from the event log in the
          same transaction — computed once, never hand-edited, never regenerated on read.
          It is a document you can paste into a report, also served as markdown at
          <code>/boards/:id/summary.md</code>.
        </p>
        <div class="closeout reveal">
          <p class="closeout-title">{CLOSE_OUT.title}</p>
          <p class="closeout-outcome mono">{CLOSE_OUT.outcome}</p>
          <div class="closeout-cols">
            <div>
              <h3 class="closeout-h">Done</h3>
              <ul>
                {CLOSE_OUT.done.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="closeout-h">Remaining</h3>
              <ul>
                {CLOSE_OUT.remaining.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="closeout-h">People</h3>
              <p class="mono closeout-people">{CLOSE_OUT.people}</p>
            </div>
          </div>
          <pre class="closeout-rhythm" aria-label="Events per week, as bars">{CLOSE_OUT.rhythm}</pre>
        </div>
        <ArrowLink href="/docs/v2/features/close-out">Read the close-out spec</ArrowLink>
      </div>
    </Section>

    <Section title="Point an agent at the board.">
      <div class="agents-grid">
        <div>
          <p>
            Create a per-board agent key in the setup panel: it can read and write that one
            board and nothing else, with the same permissions a human link holder has. The
            key is shown once at creation and can be revoked at any time. The config block
            below is what a human pastes into their client.
          </p>
          <div class="agents-links">
            <ArrowLink href="/docs/v2/mcp">MCP reference</ArrowLink>
            <ArrowLink href="/docs/v2/features/agents">Setup panel</ArrowLink>
          </div>
        </div>
        <CodeBlock code={MCP_CONFIG} lang="json" copyLabel="Copy the config" />
      </div>
      <p class="section-footnote mono">
        {CLAIMS.tools.value} tools · JSON-RPC 2.0 · POST /mcp
      </p>
    </Section>

    <Section title="What it does not do">
      <ul class="limits-list">
        {CLAIMS.limits.value.map((limit) => <li class="limit-row">{limit}</li>)}
      </ul>
      <p class="limits-close">If one of these is a blocker, Klui is not the right tool yet.</p>
    </Section>

    <section class="final-cta reveal">
      <h2 class="final-title">Run it in five minutes.</h2>
      <div class="final-copy">
        <CopyButton text={INSTALL_COMMANDS} label="Copy the install command" />
      </div>
      <p class="final-note">No account, no licence key, no telemetry unless you turn it on.</p>
    </section>
  </main>
</Base>

<script>
  // One reveal per section: opacity + 8px, 500ms, once. Only enabled when the browser
  // supports IntersectionObserver and the user allows motion; without JS everything is
  // already visible.
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (motionOk && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-motion');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }
</script>

<style>
  .hero-zone {
    position: relative;
    overflow: hidden;
  }

  .three-lines {
    margin-top: 8px;
  }

  .line-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: end;
    padding: 24px 0;
    border-top: 1px solid var(--border);
  }

  .line-row:first-child {
    border-top: none;
  }

  .line-claim {
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h3);
  }

  .line-body {
    margin-top: 8px;
    max-width: 60ch;
    color: var(--ink-muted);
  }

  .install-grid,
  .end-grid,
  .agents-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px;
    align-items: start;
  }

  .install-steps p + p {
    margin-top: 12px;
  }

  .install-steps code,
  .end-copy code {
    background-color: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-inline);
    padding: 0 5px;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-mono-sm);
  }

  .install-caption {
    color: var(--ink-subtle);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-mono-sm);
  }

  .end-grid {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .end-copy {
    color: var(--ink-muted);
    max-width: 46ch;
  }

  .closeout {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    padding: 20px;
  }

  .closeout-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--tracking-h2);
  }

  .closeout-outcome {
    margin-top: 8px;
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  .closeout-cols {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .closeout-h {
    font-size: var(--text-label);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    color: var(--ink-subtle);
  }

  .closeout-cols ul {
    margin-top: 8px;
    padding-left: 16px;
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-small);
  }

  .closeout-cols li + li {
    margin-top: 4px;
  }

  .closeout-people {
    margin-top: 8px;
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-mono-sm);
    color: var(--ink-muted);
  }

  .closeout-rhythm {
    margin-top: 16px;
    overflow-x: auto;
    font-size: var(--text-mono);
    line-height: var(--lh-mono);
    color: var(--ink);
  }

  .agents-links {
    margin-top: 24px;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .limits-list {
    margin-top: 8px;
    list-style: none;
    max-width: 60ch;
  }

  .limit-row {
    padding: 24px 0;
    border-top: 1px solid var(--border);
    font-size: var(--text-body);
    line-height: var(--lh-body);
    letter-spacing: var(--tracking-body);
  }

  .limit-row:first-child {
    border-top: none;
  }

  .limits-close {
    margin-top: 24px;
    color: var(--ink-muted);
  }

  .final-cta {
    border-top: 1px solid var(--border);
    padding: var(--section-pad-lg) 24px;
    text-align: center;
  }

  .final-title {
    font-size: var(--text-display-sm);
    line-height: var(--lh-display-sm);
    letter-spacing: var(--tracking-h1);
  }

  .final-copy {
    margin-top: 32px;
    display: flex;
    justify-content: center;
  }

  .final-copy :global(.copy-btn) {
    display: none;
    align-items: center;
    height: 44px;
    padding: 0 22px;
    border: none;
    border-radius: var(--radius-pill);
    background-color: var(--primary);
    color: var(--primary-foreground);
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    cursor: pointer;
  }

  html.js .final-copy :global(.copy-btn) {
    display: inline-flex;
  }

  .final-copy :global(.copy-btn:hover) {
    background-color: var(--primary-hover);
  }

  .final-note {
    margin-top: 16px;
    color: var(--ink-subtle);
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-small);
  }

  html.js-motion .reveal {
    opacity: 0;
    transform: translateY(8px);
  }

  html.js-motion .reveal.revealed {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--reveal-duration) var(--reveal-ease),
      transform var(--reveal-duration) var(--reveal-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    html.js-motion .reveal {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1023px) {
    .install-grid,
    .end-grid,
    .agents-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .line-row {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 12px;
    }

    .closeout-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
