---
// SPDX-License-Identifier: AGPL-3.0-only
// The copy island: clipboard + aria-live. Hidden without JS (the <pre> stays selectable);
// the script below reveals it only when clipboard APIs exist.
interface Props {
  text: string;
  label: string;
}

const { text, label } = Astro.props;
---

<button type="button" class="copy-btn" data-copy={text} aria-label={label}>
  <svg class="copy-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5" />
    <path d="M10.5 5.5V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" stroke="currentColor" stroke-width="1.5" />
  </svg>
  <span class="copy-label">{label}</span>
</button>
<span class="copy-status sr-only" aria-live="polite"></span>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');
  document.documentElement.classList.add('js');
  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      const label = button.querySelector('.copy-label');
      const status = button.parentElement?.querySelector('.copy-status') ?? button.nextElementSibling;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const area = document.createElement('textarea');
        area.value = text;
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        area.remove();
      }
      if (label) label.textContent = 'Copied';
      if (status) status.textContent = 'Copied';
      window.setTimeout(() => {
        if (label) label.textContent = button.getAttribute('aria-label') ?? 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>

<style>
  .copy-btn {
    display: none;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: var(--text-mono-sm);
    letter-spacing: var(--tracking-mono-sm);
    cursor: pointer;
  }

  html.js .copy-btn {
    display: inline-flex;
  }

  .copy-btn:hover {
    background-color: var(--surface-2);
    color: var(--ink);
  }

  .copy-icon {
    flex: none;
  }
</style>
