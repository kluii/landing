---
// SPDX-License-Identifier: AGPL-3.0-only
// Starlight PageTitle override (L5): every synced docs page carries its own H1 in the
// markdown body (the sync derives the frontmatter title from it), so rendering
// Starlight's title as well produced two <h1> per docs route. When the entry body
// starts with an H1, Starlight's title is not rendered and the markdown H1 is the
// page's single h1. The .md twins and llms.txt keep the heading.
const body = Astro.locals.starlightRoute.entry.body;
const hasContentH1 = /^#\s/m.test(body.replace(/^```[\s\S]*?^```/gm, ''));
---

{
  hasContentH1 ? (
    // The markdown H1 is the page's single h1; keep the #_top anchor (skip link, TOC)
    // alive without rendering a second heading.
    <span id="_top" aria-hidden="true" />
  ) : (
    <h1 id="_top">{Astro.locals.starlightRoute.entry.data.title}</h1>
  )
}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
