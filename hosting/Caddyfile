# Caddy config for the site (docs/deploy.md §2). Traefik equivalent: a file-server container
# with the same headers middleware and an immutable-cache router rule on /_astro/*.

klui.wyliam.dev {
  root * /srv/klui-site/current
  encode zstd gzip
  file_server

  header /docs/*.md Content-Type "text/markdown; charset=utf-8"
  header /llms.txt Content-Type "text/markdown; charset=utf-8"

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
  }

  header /*.html Cache-Control "public, max-age=0, must-revalidate"
  header /_astro/* Cache-Control "public, max-age=31536000, immutable"
  header /fonts/* Cache-Control "public, max-age=31536000, immutable"
  header /og/*.png Cache-Control "public, max-age=3600"
}
